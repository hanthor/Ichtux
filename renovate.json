{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies", "renovate"],
  "schedule": ["before 6am on Monday"],
  "timezone": "UTC",
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchDatasources": ["github-tags", "github-releases"],
      "automerge": false,
      "schedule": ["before 6am on Monday"]
    }
  ],
  "regexManagers": [
    {
      "description": "Update Linux Kernel versions in Containerfiles",
      "fileMatch": [
        "^containerfiles/.*/Containerfile$"
      ],
      "matchStrings": [
        "ARG LINUX_VERSION=(?<currentValue>.*?)\\n"
      ],
      "depNameTemplate": "linux",
      "datasourceTemplate": "custom.kernel",
      "versioningTemplate": "loose"
    },
    {
      "description": "Update GCC versions in Containerfiles",
      "fileMatch": [
        "^containerfiles/.*/Containerfile$"
      ],
      "matchStrings": [
        "ARG GCC_VERSION=(?<currentValue>.*?)\\n"
      ],
      "depNameTemplate": "gcc",
      "datasourceTemplate": "custom.gnu",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "loose"
    },
    {
      "description": "Update Glibc versions in Containerfiles",
      "fileMatch": [
        "^containerfiles/.*/Containerfile$"
      ],
      "matchStrings": [
        "ARG GLIBC_VERSION=(?<currentValue>.*?)\\n"
      ],
      "depNameTemplate": "glibc",
      "datasourceTemplate": "custom.gnu",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)$",
      "versioningTemplate": "loose"
    },
    {
      "description": "Update Binutils versions in Containerfiles",
      "fileMatch": [
        "^containerfiles/.*/Containerfile$"
      ],
      "matchStrings": [
        "ARG BINUTILS_VERSION=(?<currentValue>.*?)\\n"
      ],
      "depNameTemplate": "binutils",
      "datasourceTemplate": "custom.gnu",
      "versioningTemplate": "loose"
    },
    {
      "description": "Update systemd versions in Containerfiles",
      "fileMatch": [
        "^containerfiles/.*/Containerfile$"
      ],
      "matchStrings": [
        "ARG SYSTEMD_VERSION=(?<currentValue>.*?)\\n"
      ],
      "depNameTemplate": "systemd/systemd",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "loose"
    },
