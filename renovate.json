    }
  ],
  "customDatasources": {
    "kernel": {
      "defaultRegistryUrlTemplate": "https://www.kernel.org/",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": $map(releases.*, function($v) { {\"version\": $v.version} })}"
      ]
    },
    "gnu": {
      "defaultRegistryUrlTemplate": "https://ftp.gnu.org/gnu/",
      "format": "html"
    },
    "mesa": {
      "defaultRegistryUrlTemplate": "https://archive.mesa3d.org/",
      "format": "html"
    },
    "busybox": {
      "defaultRegistryUrlTemplate": "https://busybox.net/downloads/",
      "format": "html"
    },
    "freedesktop": {
      "defaultRegistryUrlTemplate": "https://dri.freedesktop.org/",
      "format": "html"
    }
  }
